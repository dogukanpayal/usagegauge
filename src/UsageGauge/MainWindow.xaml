<Window x:Class="UsageGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageGauge"
        Width="340"
        SizeToContent="Height"
        MaxHeight="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Left="80" Top="80">

    <Window.Resources>
        <!-- Düz, Modern İlerleme Çubuğu Şablonu -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sade Buton Şablonu -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
        <Border.ContextMenu>
            <ContextMenu x:Name="WidgetContextMenu">
                <MenuItem Header="Şimdi Yenile" Click="MenuRefresh_Click"/>
                <MenuItem Header="Ayarlar..." Click="MenuSettings_Click"/>
                <Separator/>
                <MenuItem Header="Gizle (Bildirim Alanına)" Click="MenuHide_Click"/>
                <Separator/>
                <MenuItem Header="Çıkış" Click="MenuExit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid x:Name="MainRootGrid" Margin="10,8,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık Çubuğu & Kontroller -->
                <RowDefinition Height="Auto"/> <!-- İçerik Alanı: Normal / Orta / Mini -->
            </Grid.RowDefinitions>

            <!-- Başlık Çubuğu: Sürükleme Tutamacı ve İşlem Düğmeleri -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sürükleme Alanı: Başlık ve Son Kontrol Zamanı -->
                <Border Grid.Column="0"
                        x:Name="DragHandle"
                        Background="Transparent"
                        Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="DragHandle_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                        LostMouseCapture="DragHandle_LostMouseCapture">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UsageGauge"
                                   Foreground="#38BDF8"
                                   FontWeight="Bold"
                                   FontSize="12"/>
                        <TextBlock x:Name="TxtLastChecked"
                                   Text="{Binding LastCheckedText}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Kontroller: Yenile, Ayarlar, Gizle ve Kapat -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh"
                            Style="{StaticResource HeaderButtonStyle}"
                            ToolTip="Şimdi Yenile"
                            Click="BtnRefresh_Click">
                        <TextBlock Text="⟳" FontSize="13" Margin="0,-1,0,0"/>
                    </Button>
                    <Button x:Name="BtnSettings"
                            Style="{StaticResource HeaderButtonStyle}"
                            ToolTip="Ayarlar (⚙)"
                            Margin="2,0,0,0"
                            Click="BtnSettings_Click">
                        <TextBlock Text="⚙" FontSize="11" Margin="0,-1,0,0"/>
                    </Button>
                    <Button x:Name="BtnHide"
                            Style="{StaticResource HeaderButtonStyle}"
                            ToolTip="Gizle (Bildirim Alanına)"
                            Margin="2,0,0,0"
                            Click="BtnHide_Click">
                        <TextBlock Text="—" FontSize="11" Margin="0,-2,0,0"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource HeaderButtonStyle}"
                            ToolTip="Gizle (Bildirim Alanına)"
                            Margin="2,0,0,0"
                            Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="10" Margin="0,0,0,0"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- 1. Normal Görünüm Paneli (340 px Genişlik, Tam Detaylı) -->
            <!-- ======================================================== -->
            <StackPanel x:Name="NormalViewPanel" Grid.Row="1" Visibility="Visible">
                <!-- Kart 1: ChatGPT (Work / Codex) -->
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,0,8"
                        DataContext="{Binding ChatGptCard}">
                    <StackPanel>
                        <!-- Kart Başlığı ve Durum Rozeti -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       Foreground="#F1F5F9"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding StatusBadgeBackground}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    ToolTip="{Binding ErrorMessage}">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="140"/>
                            </Border>
                        </Grid>

                        <!-- 5 Saatlik Havuz -->
                        <Grid Margin="0,4,0,0" DataContext="{Binding FiveHourWindow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding RemainingPercentText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#F8FAFC"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Margin="0,3,0,2"
                                         Value="{Binding RemainingPercent}"
                                         Foreground="{Binding ProgressBrush}"/>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding CountdownText}"
                                       Foreground="#64748B"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0"/>
                        </Grid>

                        <!-- Haftalık Havuz -->
                        <Grid Margin="0,6,0,0" DataContext="{Binding WeeklyWindow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding RemainingPercentText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#F8FAFC"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Margin="0,3,0,2"
                                         Value="{Binding RemainingPercent}"
                                         Foreground="{Binding ProgressBrush}"/>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding CountdownText}"
                                       Foreground="#64748B"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Kart 2: Antigravity Gemini -->
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        DataContext="{Binding GeminiCard}">
                    <StackPanel>
                        <!-- Kart Başlığı ve Durum Rozeti -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       Foreground="#F1F5F9"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding StatusBadgeBackground}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    ToolTip="{Binding ErrorMessage}">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="140"/>
                            </Border>
                        </Grid>

                        <!-- 5 Saatlik Havuz -->
                        <Grid Margin="0,4,0,0" DataContext="{Binding FiveHourWindow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding RemainingPercentText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#F8FAFC"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Margin="0,3,0,2"
                                         Value="{Binding RemainingPercent}"
                                         Foreground="{Binding ProgressBrush}"/>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding CountdownText}"
                                       Foreground="#64748B"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0"/>
                        </Grid>

                        <!-- Haftalık Havuz -->
                        <Grid Margin="0,6,0,0" DataContext="{Binding WeeklyWindow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding RemainingPercentText}"
                                           HorizontalAlignment="Right"
                                           Foreground="#F8FAFC"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Margin="0,3,0,2"
                                         Value="{Binding RemainingPercent}"
                                         Foreground="{Binding ProgressBrush}"/>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding CountdownText}"
                                       Foreground="#64748B"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======================================================== -->
            <!-- 2. Orta Görünüm Paneli (270 px Genişlik, Beğenilen Düzen) -->
            <!-- ======================================================== -->
            <StackPanel x:Name="MediumViewPanel" Grid.Row="1" Visibility="Collapsed">
                <!-- Orta Kart 1: ChatGPT (Codex) -->
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,0,0,6"
                        DataContext="{Binding ChatGptCard}">
                    <StackPanel>
                        <!-- Başlık ve Durum Rozeti -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       Foreground="#F1F5F9"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,4,0"/>
                            <Border Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding StatusBadgeBackground}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    ToolTip="{Binding ErrorMessage}">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="Medium"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="115"/>
                            </Border>
                        </Grid>

                        <!-- 5 Saatlik Havuz -->
                        <Grid Margin="0,2,0,2" DataContext="{Binding FiveHourWindow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="5 Saat" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Value="{Binding RemainingPercent}" Foreground="{Binding ProgressBrush}" Height="5" Margin="4,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding RemainingPercentText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShortCountdownText}" ToolTip="{Binding CountdownText}" Foreground="#64748B" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center" MinWidth="42" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>

                        <!-- Haftalık Havuz -->
                        <Grid Margin="0,2,0,0" DataContext="{Binding WeeklyWindow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hafta" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Value="{Binding RemainingPercent}" Foreground="{Binding ProgressBrush}" Height="5" Margin="4,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding RemainingPercentText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShortCountdownText}" ToolTip="{Binding CountdownText}" Foreground="#64748B" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center" MinWidth="42" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Orta Kart 2: Antigravity Gemini -->
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6"
                        DataContext="{Binding GeminiCard}">
                    <StackPanel>
                        <!-- Başlık ve Durum Rozeti -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       Foreground="#F1F5F9"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,4,0"/>
                            <Border Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{Binding StatusBadgeBackground}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    ToolTip="{Binding ErrorMessage}">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="Medium"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="115"/>
                            </Border>
                        </Grid>

                        <!-- 5 Saatlik Havuz -->
                        <Grid Margin="0,2,0,2" DataContext="{Binding FiveHourWindow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="5 Saat" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Value="{Binding RemainingPercent}" Foreground="{Binding ProgressBrush}" Height="5" Margin="4,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding RemainingPercentText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShortCountdownText}" ToolTip="{Binding CountdownText}" Foreground="#64748B" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center" MinWidth="42" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>

                        <!-- Haftalık Havuz -->
                        <Grid Margin="0,2,0,0" DataContext="{Binding WeeklyWindow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hafta" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Value="{Binding RemainingPercent}" Foreground="{Binding ProgressBrush}" Height="5" Margin="4,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding RemainingPercentText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding ShortCountdownText}" ToolTip="{Binding CountdownText}" Foreground="#64748B" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center" MinWidth="42" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======================================================== -->
            <!-- 3. Orta-Mini Görünüm Paneli (200 px, Kompakt 2x2 Düzen)    -->
            <!-- ======================================================== -->
            <StackPanel x:Name="MediumMiniViewPanel" Grid.Row="1" Visibility="Collapsed">
                <!-- Mini Kart 1: ChatGPT (Work/Codex) -->
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,5"
                        Margin="0,0,0,5"
                        DataContext="{Binding ChatGptCard}">
                    <StackPanel>
                        <!-- Başlık ve Durum Rozeti -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="ChatGPT"
                                       Foreground="#F1F5F9"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1"
                                    Background="{Binding StatusBadgeBackground}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    ToolTip="{Binding ErrorMessage}">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="Medium"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="85"/>
                            </Border>
                        </Grid>

                        <!-- İki Havuz Yan Yana (5 Saat ve Hafta) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 5 Saatlik Havuz Kutusu -->
                            <Border Grid.Column="0"
                                    Background="#0F172A"
                                    BorderBrush="#293548"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,3"
                                    DataContext="{Binding FiveHourWindow}"
                                    ToolTip="{Binding CountdownText}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="5 Saat" FontSize="8.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RemainingPercentText}" FontSize="11" FontWeight="Bold" Foreground="{Binding ProgressBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding RemainingPercent}" Foreground="{Binding ProgressBrush}" Height="3" Margin="0,2,0,1"/>
                                    <TextBlock Text="{Binding ShortCountdownText}" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>

                            <!-- Haftalık Havuz Kutusu -->
                            <Border Grid.Column="2"
                                    Background="#0F172A"
                                    BorderBrush="#293548"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,3"
                                    DataContext="{Binding WeeklyWindow}"
                                    ToolTip="{Binding CountdownText}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Hafta" FontSize="8.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RemainingPercentText}" FontSize="11" FontWeight="Bold" Foreground="{Binding ProgressBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding RemainingPercent}" Foreground="{Binding ProgressBrush}" Height="3" Margin="0,2,0,1"/>
                                    <TextBlock Text="{Binding ShortCountdownText}" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mini Kart 2: Antigravity Gemini -->
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,5"
                        DataContext="{Binding GeminiCard}">
                    <StackPanel>
                        <!-- Başlık ve Durum Rozeti -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Gemini"
                                       Foreground="#F1F5F9"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1"
                                    Background="{Binding StatusBadgeBackground}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    ToolTip="{Binding ErrorMessage}">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="Medium"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="85"/>
                            </Border>
                        </Grid>

                        <!-- İki Havuz Yan Yana (5 Saat ve Hafta) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 5 Saatlik Havuz Kutusu -->
                            <Border Grid.Column="0"
                                    Background="#0F172A"
                                    BorderBrush="#293548"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,3"
                                    DataContext="{Binding FiveHourWindow}"
                                    ToolTip="{Binding CountdownText}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="5 Saat" FontSize="8.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RemainingPercentText}" FontSize="11" FontWeight="Bold" Foreground="{Binding ProgressBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding RemainingPercent}" Foreground="{Binding ProgressBrush}" Height="3" Margin="0,2,0,1"/>
                                    <TextBlock Text="{Binding ShortCountdownText}" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>

                            <!-- Haftalık Havuz Kutusu -->
                            <Border Grid.Column="2"
                                    Background="#0F172A"
                                    BorderBrush="#293548"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,3"
                                    DataContext="{Binding WeeklyWindow}"
                                    ToolTip="{Binding CountdownText}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Hafta" FontSize="8.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RemainingPercentText}" FontSize="11" FontWeight="Bold" Foreground="{Binding ProgressBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding RemainingPercent}" Foreground="{Binding ProgressBrush}" Height="3" Margin="0,2,0,1"/>
                                    <TextBlock Text="{Binding ShortCountdownText}" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======================================================== -->
            <!-- 4. Yeni Yatay Mini Görünüm Paneli (Tek Satır Kota + Sayaç) -->
            <!-- ======================================================== -->
            <Grid x:Name="MiniViewPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Sütun 0: Kaynak Adı (ChatGPT / Gemini) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Sütun 1: Durum Göstergesi (● ve Metin) - İçeriğe göre dinamik -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Sütun 2: 5 Saatlik Havuz (5 Saatlik %100 · 4s 25d) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Sütun 3: Haftalık Havuz (Haftalık %100 · 6g 23s) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Satır: ChatGPT (Work / Codex) -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="ChatGPT"
                           Foreground="#F1F5F9"
                           FontWeight="SemiBold"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            DataContext="{Binding ChatGptCard}"
                            ToolTip="{Binding StatusTooltipText}"
                            Cursor="Help">
                    <TextBlock Text="●"
                               Foreground="{Binding StatusBrush}"
                               FontSize="8"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="9"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="39"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            DataContext="{Binding ChatGptCard.FiveHourWindow}"
                            ToolTip="{Binding CountdownText}"
                            Cursor="Help">
                    <TextBlock Text="5 Saatlik "
                               Foreground="#94A3B8"
                               FontSize="9.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RemainingPercentText}"
                               Foreground="{Binding ProgressBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" · "
                               Foreground="#475569"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ShortCountdownText}"
                               Foreground="#64748B"
                               FontSize="8.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            DataContext="{Binding ChatGptCard.WeeklyWindow}"
                            ToolTip="{Binding CountdownText}"
                            Cursor="Help">
                    <TextBlock Text="Haftalık "
                               Foreground="#94A3B8"
                               FontSize="9.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RemainingPercentText}"
                               Foreground="{Binding ProgressBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" · "
                               Foreground="#475569"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ShortCountdownText}"
                               Foreground="#64748B"
                               FontSize="8.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 2. Satır: Antigravity Gemini -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Gemini"
                           Foreground="#F1F5F9"
                           FontWeight="SemiBold"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,3,6,0"/>

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,3,10,0"
                            DataContext="{Binding GeminiCard}"
                            ToolTip="{Binding StatusTooltipText}"
                            Cursor="Help">
                    <TextBlock Text="●"
                               Foreground="{Binding StatusBrush}"
                               FontSize="8"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="9"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="39"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,3,10,0"
                            DataContext="{Binding GeminiCard.FiveHourWindow}"
                            ToolTip="{Binding CountdownText}"
                            Cursor="Help">
                    <TextBlock Text="5 Saatlik "
                               Foreground="#94A3B8"
                               FontSize="9.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RemainingPercentText}"
                               Foreground="{Binding ProgressBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" · "
                               Foreground="#475569"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ShortCountdownText}"
                               Foreground="#64748B"
                               FontSize="8.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,3,0,0"
                            DataContext="{Binding GeminiCard.WeeklyWindow}"
                            ToolTip="{Binding CountdownText}"
                            Cursor="Help">
                    <TextBlock Text="Haftalık "
                               Foreground="#94A3B8"
                               FontSize="9.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RemainingPercentText}"
                               Foreground="{Binding ProgressBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" · "
                               Foreground="#475569"
                               FontSize="9"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ShortCountdownText}"
                               Foreground="#64748B"
                               FontSize="8.5"
                               FontWeight="Normal"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
