<Window x:Class="UsageGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageGauge"
        Width="340"
        SizeToContent="Height"
        MaxHeight="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Left="80" Top="80">

    <Window.Resources>
        <!-- Düz, Modern İlerleme Çubuğu Şablonu -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sade Buton Şablonu -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
        <Border.ContextMenu>
            <ContextMenu x:Name="WidgetContextMenu">
                <MenuItem Header="Şimdi Yenile" Click="MenuRefresh_Click"/>
                <MenuItem x:Name="MenuMoveToMonitor" Header="Monitöre Taşı"/>
                <MenuItem Header="Varsayılan Konuma Sıfırla" Click="MenuResetPosition_Click"/>
                <Separator/>
                <MenuItem Header="Opaklık">
                    <MenuItem x:Name="MenuOpacity100" Header="%100" Click="MenuOpacity_Click" Tag="1.0"/>
                    <MenuItem x:Name="MenuOpacity80" Header="%80" Click="MenuOpacity_Click" Tag="0.8"/>
                    <MenuItem x:Name="MenuOpacity60" Header="%60" Click="MenuOpacity_Click" Tag="0.6"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Çıkış" Click="MenuExit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık Çubuğu & Kontroller -->
                <RowDefinition Height="Auto"/> <!-- Kart 1: ChatGPT (Work/Codex) -->
                <RowDefinition Height="Auto"/> <!-- Kart 2: Antigravity Gemini -->
            </Grid.RowDefinitions>

            <!-- Başlık Çubuğu: Sürükleme Tutamacı ve İşlem Düğmeleri -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sürükleme Alanı: Başlık ve Son Kontrol Zamanı -->
                <Border Grid.Column="0"
                        x:Name="DragHandle"
                        Background="Transparent"
                        Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="DragHandle_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                        LostMouseCapture="DragHandle_LostMouseCapture">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UsageGauge"
                                   Foreground="#38BDF8"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                        <TextBlock x:Name="TxtLastChecked"
                                   Text="{Binding LastCheckedText}"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   Margin="8,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Kontroller: Yenile ve Kapat -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh"
                            Style="{StaticResource HeaderButtonStyle}"
                            ToolTip="Şimdi Yenile"
                            Click="BtnRefresh_Click">
                        <TextBlock Text="⟳" FontSize="14" Margin="0,-2,0,0"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource HeaderButtonStyle}"
                            ToolTip="Kapat"
                            Margin="4,0,0,0"
                            Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="11" Margin="0,0,0,0"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Kart 1: ChatGPT (Work / Codex) -->
            <Border Grid.Row="1"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,8"
                    DataContext="{Binding ChatGptCard}">
                <StackPanel>
                    <!-- Kart Başlığı ve Durum Rozeti: 2 sütunlu grid ile çakışma önlenir -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   Foreground="#F1F5F9"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,6,0"/>
                        <Border Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{Binding StatusBadgeBackground}"
                                CornerRadius="4"
                                Padding="5,2"
                                ToolTip="{Binding ErrorMessage}">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrush}"
                                       FontWeight="Medium"
                                       FontSize="10"/>
                        </Border>
                    </Grid>

                    <!-- 5 Saatlik Havuz -->
                    <Grid Margin="0,2,0,0" DataContext="{Binding FiveHourWindow}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding RemainingPercentText}"
                                       HorizontalAlignment="Right"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Grid>
                        <ProgressBar Grid.Row="1"
                                     Margin="0,3,0,2"
                                     Value="{Binding RemainingPercent}"
                                     Foreground="{Binding ProgressBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding CountdownText}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,1,0,0"/>
                    </Grid>

                    <!-- Haftalık Havuz -->
                    <Grid Margin="0,6,0,0" DataContext="{Binding WeeklyWindow}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding RemainingPercentText}"
                                       HorizontalAlignment="Right"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Grid>
                        <ProgressBar Grid.Row="1"
                                     Margin="0,3,0,2"
                                     Value="{Binding RemainingPercent}"
                                     Foreground="{Binding ProgressBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding CountdownText}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,1,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Kart 2: Antigravity Gemini Modelleri -->
            <Border Grid.Row="2"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    DataContext="{Binding GeminiCard}">
                <StackPanel>
                    <!-- Kart Başlığı ve Durum Rozeti -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   Foreground="#F1F5F9"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,6,0"/>
                        <Border Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{Binding StatusBadgeBackground}"
                                CornerRadius="4"
                                Padding="5,2"
                                ToolTip="{Binding ErrorMessage}">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrush}"
                                       FontWeight="Medium"
                                       FontSize="10"/>
                        </Border>
                    </Grid>

                    <!-- 5 Saatlik Havuz -->
                    <Grid Margin="0,2,0,0" DataContext="{Binding FiveHourWindow}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding RemainingPercentText}"
                                       HorizontalAlignment="Right"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Grid>
                        <ProgressBar Grid.Row="1"
                                     Margin="0,3,0,2"
                                     Value="{Binding RemainingPercent}"
                                     Foreground="{Binding ProgressBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding CountdownText}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,1,0,0"/>
                    </Grid>

                    <!-- Haftalık Havuz -->
                    <Grid Margin="0,6,0,0" DataContext="{Binding WeeklyWindow}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding Title}" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="{Binding RemainingPercentText}"
                                       HorizontalAlignment="Right"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Grid>
                        <ProgressBar Grid.Row="1"
                                     Margin="0,3,0,2"
                                     Value="{Binding RemainingPercent}"
                                     Foreground="{Binding ProgressBrush}"/>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding CountdownText}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,1,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
