<Window x:Class="UsageGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageGauge — T03.3 Dinamik Z-Order Pencere Spike'ı"
        Width="490" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Left="80" Top="80">

    <Border Background="#12151E"
            BorderBrush="#2B3245"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık ve Bağımsız Kapatma Düğmesi -->
                <RowDefinition Height="Auto"/> <!-- Telemetri & Canlı Durum Paneli -->
                <RowDefinition Height="Auto"/> <!-- Test Kontrolleri Butonları -->
                <RowDefinition Height="*"/>    <!-- 4 Manuel Test Rehberi -->
                <RowDefinition Height="Auto"/> <!-- Alt Bilgi ve Alt Kapat Butonu -->
            </Grid.RowDefinitions>

            <!-- Başlık Çubuğu: Sürükleme alanı ve üst kapatma düğmesi ayrık sütunlardadır -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sürükleme Tutamacı: SADECE başlık alanını kapsar -->
                <Border Grid.Column="0"
                        x:Name="DragHandle"
                        Background="#1A1E2D"
                        CornerRadius="6,0,0,6"
                        Padding="12,8"
                        Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="DragHandle_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp"
                        LostMouseCapture="DragHandle_LostMouseCapture">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="UsageGauge"
                                       Foreground="#60A5FA"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                            <TextBlock Text=" — T03.3 WispDock Z-Order"
                                       Foreground="#94A3B8"
                                       FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="Bu alandan tutarak pencereler arkasında serbestçe sürükleyebilirsiniz"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Üst Kapatma Düğmesi: DragHandle dışındadır, tıklamaları yutulamaz -->
                <Border Grid.Column="1"
                        Background="#1A1E2D"
                        CornerRadius="0,6,6,0"
                        Padding="4,8,8,8">
                    <Button x:Name="BtnCloseTop"
                            Content="✕"
                            Focusable="False"
                            Width="28" Height="28"
                            Background="#262D3D"
                            Foreground="#CBD5E1"
                            BorderBrush="#3B4254"
                            BorderThickness="1"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnClose_Click"/>
                </Border>
            </Grid>

            <!-- Telemetri Kartı: HWND, Dinamik Mod, Z-Order Durumu, Odak -->
            <Border Grid.Row="1"
                    Background="#161A26"
                    BorderBrush="#252C3E"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,10,0,0"
                    Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- HWND ve Mimari Mod -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pencere / Mod:" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                        <TextBlock x:Name="TxtHwnd" Text="0x00000000" Foreground="#F8FAFC" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock Text=" | " Foreground="#64748B" Margin="4,0"/>
                        <TextBlock Text="Dinamik Z-Order (WispDock)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>

                    <!-- Canlı Z-Order Katmanı -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Z-Order Durumu:" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtZOrderStatus" Text="İzleniyor..." Foreground="#4ADE80" FontWeight="SemiBold" FontSize="11" Margin="0,2" TextTrimming="CharacterEllipsis"/>

                    <!-- Konum -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Konum (X, Y):" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtCoords" Text="X: 80, Y: 80" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11" Margin="0,2"/>

                    <!-- Referans Hedef Pencere -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Referans Pencere:" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtBaselineWindow" Text="(Henüz kilitlenmedi)" Foreground="#FBBF24" FontSize="11" Margin="0,2" TextTrimming="CharacterEllipsis"/>

                    <!-- Canlı Aktif Pencere -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Şu Anki Ön Pencere:" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtCurrentWindow" Text="İzleniyor..." Foreground="#CBD5E1" FontSize="11" Margin="0,2" TextTrimming="CharacterEllipsis"/>

                    <!-- Odak Değerlendirmesi -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Odak Sonucu:" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtFocusResult" Text="Bekleniyor..." Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- Test Kontrolleri Butonları -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="BtnLockBaseline"
                        Content="Ön Pencereyi Kilitle"
                        Focusable="False"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Padding="4,6"
                        FontSize="11"
                        Cursor="Hand"
                        Click="BtnLockBaseline_Click"/>

                <Button Grid.Column="2"
                        x:Name="BtnRefreshZOrder"
                        Content="Z-Sırasını Güncelle"
                        Focusable="False"
                        Background="#1E293B"
                        Foreground="#38BDF8"
                        BorderBrush="#0284C7"
                        BorderThickness="1"
                        Padding="4,6"
                        FontSize="11"
                        Cursor="Hand"
                        Click="BtnRefreshZOrder_Click"/>

                <Button Grid.Column="4"
                        x:Name="BtnOpenLog"
                        Content="Teşhis Logu Aç"
                        Focusable="False"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Padding="4,6"
                        FontSize="11"
                        Cursor="Hand"
                        Click="BtnOpenLog_Click"/>
            </Grid>

            <!-- 4 Manuel Test Rehberi -->
            <Border Grid.Row="3"
                    Background="#141822"
                    BorderBrush="#232A3B"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,10,0,0"
                    Padding="10,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="WINDOWS 11 TEST ADIMLARI (T03.3 - WISPDOCK MODELİ)"
                                   Foreground="#FBBF24"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>

                        <!-- Test 1 -->
                        <Border Background="#1A2030" Padding="6,3" Margin="0,0,0,3" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="1. Normal Pencere Arkasında Kalma (Önceden GEÇTİ ✓):" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Text="Tarayıcı veya IDE açıldığında widget HWND_NOTOPMOST katmanında uygulamanın arkasında kalmalıdır."
                                           Foreground="#94A3B8" FontSize="9.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Test 2 -->
                        <Border Background="#1A2030" Padding="6,3" Margin="0,0,0,3" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="2. Win + D (Masaüstünü Göster — WispDock Modeli):" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Text="Klavyeden Win + D tuşlayın. Pencereler küçüldüğünde Windows Shell masaüstü ön plana çıkar; widget SC_MINIMIZE engellemesi ve WinEvent kancası sayesinde masaüstü yüzeyinde doğrudan görünür kalmalıdır."
                                           Foreground="#94A3B8" FontSize="9.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Test 3 -->
                        <Border Background="#1A2030" Padding="6,3" Margin="0,0,0,3" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="3. Tıklama/Taşıma Odak Davranışı (Önceden GEÇTİ ✓):" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Text="Hedef pencere (Notepad) aktifken widget sürüklendiğinde 'Odak referansta korundu ✓' yeşil kalmalı ve odak çalınmamalıdır."
                                           Foreground="#94A3B8" FontSize="9.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Test 4 -->
                        <Border Background="#1A2030" Padding="6,3" Margin="0,0,0,2" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="4. İki Monitör Arasında Taşıma (Önceden GEÇTİ ✓):" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Text="Widget başlığından tutularak Monitör 1'den Monitör 2'ye serbestçe taşınabilmelidir."
                                           Foreground="#94A3B8" FontSize="9.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Alt Kısım: Durum Mesajı ve Alt Kapat Butonu -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TxtStatus"
                           Text="Hazır."
                           Foreground="#64748B"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="1"
                        x:Name="BtnCloseBottom"
                        Content="Uygulamayı Kapat"
                        Focusable="False"
                        Background="#7F1D1D"
                        Foreground="#FCA5A5"
                        BorderBrush="#991B1B"
                        BorderThickness="1"
                        Padding="10,4"
                        FontSize="11"
                        Cursor="Hand"
                        Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
